{
  "name": "medidor-anillo-hibrida",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación híbrida Web/Android que mide un anillo sobre la pantalla calibrada (tallas T1–T36).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:add": "cap add android",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
